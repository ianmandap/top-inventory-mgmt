<%- include("../partials/header.ejs") %>

<%- include("../partials/sidebar.ejs", { categories: categories }) %>

<div class="content">
  <h1><%= category.name %></h1>
  <a href="/categories/<%= category.id %>/edit">Edit</a>
  <form action="/categories/<%= category.id %>/delete" method="POST" style="display:inline;">
    <button type="submit" onclick="return confirm('Are you sure you want to delete this category?');">Delete</button>
  </form>
  <a href="/items/new?category=<%= category.name %>">Create New Item</a>
  <%- include("../partials/table.ejs", { items: items }) %>
</div>
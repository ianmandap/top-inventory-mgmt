<form action=<%= actionUrl %> method="POST">
  <!-- todo: pure html css does not work -->
  <select name="imageId" style="width: 32px;height: 32px;">
    <option value="brown-exotic">1</option>
    <option value="teal-exotic">2</option>
  </select>
  <input type="hidden" name="imageKey" value="pixelweapons">
  <label for="name">Name: </label>
  <input type="text" name="name" id="name" required value="<%= typeof item === 'undefined' ? '' : item.name %>">
  <label for="price">Price: </label>
  <input type="number" placeholder="0.00" required name="price" min="0" step="0.01" value=<%= typeof item === 'undefined' ? 0 : item.price %>>
  <label for="quantity">Quantity: </label>
  <input type="number" name="quantity" required value=<%= typeof item === 'undefined' ? '' : item.quantity %>>
  <select name="categoryId">
    <% categories.forEach(category => { %>
    <option <%= typeof queryParams === 'undefined' ? 
                  (typeof item === 'undefined' ? '' :
                  category.name == item.category.name ? "selected" : "") :
                  (queryParams == category.name ? "selected" : "") %> value=<%= category.id %>>
      <%= category.name %>
    </option>
    <% }) %>
  </select>
  <button type="submit">Submit</button>
</form>
<link rel="stylesheet" type="text/css" href="/css/styles.css" />

<div id="sidebar">
  <% categories.forEach(category => { %>
  <a href=<%= `/categories/${category.id}` %>><%= category.name %></a>
  <% }) %>
  <br>
  <br>
  <br>
  <a href="/categories/new">New Category</a>
</div>

<style>
  #sidebar {
    height: 100%;
    width: 50px;
    position: fixed;
    top: 0;
    left: 0;
    padding: 10% 10px 0 10px;
  }
</style>